# ==============================================================================
# FireWatch Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to a new file named exactly ".env" in the project root:
#      cp .env.example .env
# 2. Paste your 32-character NASA FIRMS key into FIRMS_MAP_KEY below.
# 3. Save the file and restart the backend server.
#
# SECURITY:
# - The ".env" file is strictly excluded by .gitignore and will never be committed.
# - Your key is only read by the Python backend and is NEVER sent to frontend code.
# ==============================================================================

# NASA FIRMS MAP_KEY (Request a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key)
# Format: 32-character hexadecimal string (e.g., FIRMS_MAP_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90)
# NOTE: Newly generated NASA keys can take 15-30 minutes to activate on NASA servers.
# If left blank, FireWatch runs safely in high-fidelity synthetic demo mode.
FIRMS_MAP_KEY=

# Local SQLite Database Path (Optional, defaults to backend/firewatch.db)
FIREWATCH_DB_PATH=backend/firewatch.db

# Server Host & Port
HOST=127.0.0.1
PORT=8000

