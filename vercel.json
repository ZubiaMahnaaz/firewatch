{
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "firewatch-backend": {
      "root": ".",
      "entrypoint": "api/index.py",
      "buildCommand": "pip install -r backend/requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "firewatch-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
